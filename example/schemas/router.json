{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "router.json",
  "title": "RouterOutput",
  "type": "object",
  "required": ["request_id", "category", "urgency", "confidence", "reason", "has_document"],
  "properties": {
    "request_id": { "type": "string" },
    "category": {
      "enum": ["order", "quote_request", "invoice_query", "complaint", "other"]
    },
    "urgency": { "enum": ["low", "normal", "high"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason": { "type": "string", "maxLength": 300 },
    "has_document": { "type": "boolean" }
  },
  "additionalProperties": false
}